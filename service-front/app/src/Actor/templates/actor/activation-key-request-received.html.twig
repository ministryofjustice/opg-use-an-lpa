{% extends '@actor/layout.html.twig' %}

{% block html_title %}{% trans %}request-activation-key.received.title{% endtrans %} - {{ parent() }}{% endblock %}

{% block content %}
    <div class="govuk-width-container">
        <main class="govuk-main-wrapper" id="main-content" role="main">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">
                    <div class="govuk-panel govuk-panel--confirmation">
                        <h1 class="govuk-panel__title">
                            {% trans %}request-activation-key.received.heading-page{% endtrans %}
                        </h1>
                    </div>
                </div>
                <div class="govuk-grid-column-two-thirds">

                    {% trans with {'%date%': lpa_date(date)} %}
                        request-activation-key.received.content-what-happens-next
                    {% context %}html{% notes %}Contains GOV.UK paragraph elements and classes, and a %date% placeholder for the date by which the user should have heard from us. Preserve the HTML structure, classes and placeholder when translating.{% endtrans %}

                    {{ include('@partials/contact-details/email.html.twig') }}

                    {{ include('@partials/contact-details/telephone.html.twig') }}

                    <h2 class="govuk-heading-l">
                        {% trans %}
                            request-activation-key.received.heading-more-than-one-lpa
                        {% context %}html{% notes %}Contains an abbr element for LPA. Preserve the HTML when translating.{% endtrans %}
                    </h2>

                    {% trans %}
                        request-activation-key.received.content-more-than-one-lpa
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes. Preserve the HTML structure and classes when translating.{% endtrans %}

                    <div class="moj-button-menu">
                        <a href="{{ path('lpa.add-by-paper', {}, {'requestAnother': 'true'}) }}" role="button"
                           draggable="false" class="govuk-button moj-button-menu__item  "
                           data-module="govuk-button">
                            {% trans %}request-activation-key.received.button-request-another{% endtrans %}
                        </a>
                        <a href="{{ path('lpa.dashboard') }}" role="button" draggable="false"
                           class="govuk-button moj-button-menu__item govuk-button--secondary "
                           data-module="govuk-button">
                            {% trans %}common.button-back-to-your-lpas{% endtrans %}
                        </a>
                    </div>
                </div>
            </div>
        </main>
    </div>
{% endblock %}
