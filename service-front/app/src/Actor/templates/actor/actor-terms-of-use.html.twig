{% extends '@actor/layout.html.twig' %}

{% block html_title %}{% trans %}terms-of-use.use.title{% endtrans %} - {{ parent() }}{% endblock %}

{% block content %}
    <div class="govuk-width-container">
        <main class="govuk-main-wrapper" id="main-content" role="main">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">
                    <h1 class="govuk-heading-xl" data-content-id="terms-of-use">{% trans %}terms-of-use.use.heading-page{% endtrans %}</h1>

                    {% trans %}
                        terms-of-use.use.content-intro
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes. Preserve the HTML structure and classes when translating.{% endtrans %}

                    <div class="govuk-warning-text">
                        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
                        <strong class="govuk-warning-text__text">
                            <span class="govuk-visually-hidden">{% trans %}common.warning-hidden-text{% notes %}Visually hidden prefix read out by screen readers before GOV.UK warning text, shown alongside a “!” icon. It is not visible on screen.{% endtrans %}</span>
                            {% trans %}
                                terms-of-use.use.warning-download-print
                            {% context %}html{% notes %}Contains an abbr element for LPA. Preserve the HTML when translating.{% endtrans %}
                        </strong>
                    </div>

                    {% trans %}
                        terms-of-use.use.content-agreement
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes, and links to external websites. Preserve the HTML structure, classes and link destinations when translating.{% endtrans %}

                    <h2 class="govuk-heading-m">{% trans %}terms-of-use.use.heading-attorney-responsibilities{% endtrans %}</h2>
                    {% trans %}
                        terms-of-use.use.content-attorney-responsibilities
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes, and links to external websites. Preserve the HTML structure, classes and link destinations when translating.{% endtrans %}

                    <h2 class="govuk-heading-m">{% trans %}terms-of-use.use.heading-account-security{% endtrans %}</h2>
                    {% trans %}
                        terms-of-use.use.content-account-security
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes. Preserve the HTML structure and classes when translating.{% endtrans %}

                    <h3 class="govuk-heading-s">{% trans %}terms-of-use.use.heading-access-codes{% endtrans %}</h3>
                    {% trans %}
                        terms-of-use.use.content-access-codes
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes. Preserve the HTML structure and classes when translating.{% endtrans %}

                    <h3 class="govuk-heading-s">{% trans %}terms-of-use.use.heading-access-securely{% endtrans %}</h3>
                    {% trans %}
                        terms-of-use.use.content-access-securely
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes. Preserve the HTML structure and classes when translating.{% endtrans %}

                    <h2 class="govuk-heading-m">{% trans %}terms-of-use.use.heading-information-safe{% endtrans %}</h2>
                    {% trans with {'%privacy-notice%': path('privacy-notice'), '%cookie%': path('cookies')} %}
                        terms-of-use.use.content-information-safe
                    {% context %}html-link{% notes %}Contains GOV.UK HTML markup, a privacy notice link using the %privacy-notice% placeholder and a cookie policy link using the %cookie% placeholder. Preserve the HTML and placeholders when translating.{% endtrans %}

                    <h2 class="govuk-heading-m">
                        {% trans %}
                            terms-of-use.use.heading-change-lpa
                        {% context %}html{% notes %}Contains an abbr element for LPA. Preserve the HTML when translating.{% endtrans %}
                    </h2>
                    {% trans %}
                        terms-of-use.use.content-change-lpa
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes, and links to external websites. Preserve the HTML structure, classes and link destinations when translating.{% endtrans %}

                    <h2 class="govuk-heading-m">{% trans %}terms-of-use.use.heading-online-summary{% endtrans %}</h2>
                    {% trans %}
                        terms-of-use.use.content-online-summary
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes. Preserve the HTML structure and classes when translating.{% endtrans %}

                    <h2 class="govuk-heading-m">{% trans %}terms-of-use.use.heading-governing-law{% endtrans %}</h2>
                    {% trans %}
                        terms-of-use.use.content-governing-law
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes. Preserve the HTML structure and classes when translating.{% endtrans %}

                    <h2 class="govuk-heading-m">{% trans %}terms-of-use.use.heading-about{% endtrans %}</h2>
                    {% trans %}
                        terms-of-use.use.content-about
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes. Preserve the HTML structure and classes when translating.{% endtrans %}
                </div>
            </div>
        </main>
    </div>
{% endblock %}
