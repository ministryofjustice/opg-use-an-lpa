{% extends '@actor/layout.html.twig' %}

{% block html_title %}{% trans %}add-lpa.triage.title{% endtrans %} - {{ parent() }}{% endblock %}

{% block content %}
    <div class="govuk-width-container">
        <div role="navigation" aria-labelledby="back-link-navigation">
            <a href="{{ path('lpa.dashboard') }}" class="govuk-back-link"
               id="back-link-navigation">{% trans %}common.back-link{% endtrans %}</a>
        </div>

        <main class="govuk-main-wrapper" id="main-content" role="main">
            <div class="govuk-grid-row">
                {{ govuk_form_open(form) }}

                <div class="govuk-grid-column-two-thirds">
                    {{ govuk_error_summary(form) }}
                    {{ govuk_form_element(form.get('__csrf')) }}

                    <fieldset class="govuk-fieldset">
                        <legend class="govuk-fieldset__legend govuk-fieldset__legend--xl">
                            <h1 class="govuk-fieldset__heading" data-content-id="h.add-lpa-triage">
                                {% trans %}add-lpa.triage.heading-page{% endtrans %}
                            </h1>
                        </legend>

                        {% trans %}
                            add-lpa.triage.content.activation-key-information
                        {% context %}html{% notes %}Contains GOV.UK paragraph elements and classes. Preserve the HTML structure and classes when translating.{% endtrans %}

                        {{ govuk_form_element(form.get('activation_key_triage'), {'value_options':
                            [
                                {
                                    'label': 'add-lpa.triage.field-activation-key-triage.label-yes'| trans,
                                    'value': 'Yes'
                                },
                                {
                                    'label': 'add-lpa.triage.field-activation-key-triage.label-no'| trans,
                                    'value': 'No'
                                }
                            ]}
                        ) }}
                    </fieldset>

                    <div class="govuk-button-group">
                        <button role="button" type="submit" data-prevent-double-click="true" draggable="false" class="govuk-button" data-module="govuk-button">
                            {% trans %}common.button-continue{% endtrans %}
                        </button>

                        <a href="{{ path('lpa.dashboard') }}" role="button" draggable="false" class="govuk-button govuk-button--secondary" data-module="govuk-button">
                            {% trans %}common.button-cancel{% endtrans %}
                        </a>
                    </div>

                    {{ govuk_form_close() }}
                </div>
            </div>
        </main>
    </div>
{% endblock %}
