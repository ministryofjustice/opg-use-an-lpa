{% extends '@actor/layout.html.twig' %}

{% block html_title %}{% trans %}add-lpa.activation-key.title{% endtrans %} - {{ parent() }} {% endblock %}

{% block content %}
<div class="govuk-width-container">
    <div role="navigation" aria-labelledby="back-link-navigation">
        <a href="{{ path(back) }}" class="govuk-back-link" id="back-link-navigation">{% trans %}common.back-link{% endtrans %}</a>
    </div>

    <main class="govuk-main-wrapper" id="main-content" role="main">

        <div class="govuk-grid-row">

            <div class="govuk-grid-column-two-thirds">

                {{ govuk_error_summary(form) }}

                <h1 class="govuk-heading-xl">{% trans %}add-lpa.activation-key.heading-page{% endtrans %}</h1>

                {{ govuk_form_open(form) }}

                    {{ govuk_form_element(form.get('__csrf')) }}

                    {% trans with {'%link%': path('lpa.add-by-paper-information')} %}
                        add-lpa.activation-key.content.instructions
                    {% context %}html-link{% notes %}Contains GOV.UK HTML markup and the %link% placeholder for the request-a-new-key link.{% endtrans %}

                    {% set activationKeyHint %}
                        {% trans %}
                            add-lpa.activation-key.field-activation-key.hint
                        {% context %}html{% notes %}Contains HTML line breaks. Preserve the line breaks and markup when translating.{% endtrans %}
                    {% endset %}

                    {{ govuk_form_element(form.get('activation_key'), {
                        'label': 'add-lpa.activation-key.field-activation-key.label'| trans,
                        'input_prefix' : 'C -',
                        'hint': activationKeyHint,
                        'attr' : {'class': 'govuk-input--width-20', 'label_class': 'govuk-label--m'} }) }}

                    <button data-prevent-double-click="true" type="submit" class="govuk-button govuk-!-margin-right-1">{% trans %}common.button-continue{% endtrans %}</button>

                {{ govuk_form_close() }}

            </div>
        </div>
    </main>
</div>
{% endblock %}
