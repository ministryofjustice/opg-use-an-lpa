{% extends '@actor/layout.html.twig' %}

{% block html_title %}{% trans %}request-activation-key.lpa-not-found.title{% endtrans %} - {{ parent() }}{% endblock %}

{% block content %}
    <div class="govuk-width-container">
        <div role="navigation" aria-labelledby="back-link-navigation">
            <a href="{{ path('lpa.check-answers') }}" class="govuk-back-link" id="back-link-navigation">{% trans %}common.back-link{% endtrans %}</a>
        </div>

        <main class="govuk-main-wrapper" id="main-content" role="main">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">
                    <h1 class="govuk-heading-xl" data-content-id="h.cannot-find-lpa">{% trans %}request-activation-key.lpa-not-found.heading-page{% endtrans %}</h1>

                    {% trans %}
                        request-activation-key.lpa-not-found.content-reasons
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes. Preserve the HTML structure and classes when translating.{% endtrans %}

                    <h3 class="govuk-heading-m">{% trans %}request-activation-key.lpa-not-found.heading-your-answers{% endtrans %}</h3>
                    <dl class="govuk-summary-list govuk-summary-list">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                {% trans %}
                                    request-activation-key.lpa-not-found.label-lpa-reference-number
                                {% context %}html{% notes %}Contains an abbr element for LPA. Preserve the HTML when translating.{% endtrans %}
                            </dt>
                            <dd class="govuk-summary-list__value">
                                {{ lpa_reference_number }}
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                {% trans %}request-activation-key.lpa-not-found.label-name{% endtrans %}
                            </dt>
                            <dd class="govuk-summary-list__value">
                                {{ first_name ~ ' ' ~  last_name }}
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                {% trans %}request-activation-key.lpa-not-found.label-dob{% endtrans %}
                            </dt>
                            <dd class="govuk-summary-list__value">
                                {{ code_date(dob) }}
                            </dd>
                        </div>
                        {% if live_in_uk == 'Yes' %}
                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">
                                    {% trans %}request-activation-key.lpa-not-found.label-postcode{% endtrans %}
                                </dt>
                                <dd class="govuk-summary-list__value">
                                    {{ postcode }}
                                </dd>
                            </div>
                        {% else %}
                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">
                                    {% trans %}request-activation-key.lpa-not-found.label-live-in-uk{% endtrans %}
                                </dt>
                                <dd class="govuk-summary-list__value">
                                    {% trans %}request-activation-key.lpa-not-found.value-live-in-uk-no{% endtrans %}
                                </dd>
                            </div>
                        {% endif %}
                    </dl>

                    {% trans %}
                        request-activation-key.lpa-not-found.content-contact-us
                    {% context %}html{% notes %}Contains a GOV.UK paragraph element and class. Preserve the HTML structure and classes when translating.{% endtrans %}

                    {{ include('@partials/contact-details/email.html.twig') }}

                    {{ include('@partials/contact-details/telephone.html.twig') }}

                    <div class="moj-button-menu">
                        <a href="{{ path('lpa.add-by-paper', {}, {'startAgain': 'true'}) }}" role="button"
                           draggable="false" class="govuk-button moj-button-menu__item  "
                           data-module="govuk-button">
                            {% trans %}request-activation-key.lpa-not-found.button-try-again{% endtrans %}
                        </a>
                        <a href="{{ path('lpa.dashboard') }}" role="button" draggable="false"
                           class="govuk-button moj-button-menu__item govuk-button--secondary "
                           data-module="govuk-button">
                            {% trans %}common.button-back-to-your-lpas{% endtrans %}
                        </a>
                    </div>
                </div>
            </div>
        </main>
    </div>
{% endblock %}
