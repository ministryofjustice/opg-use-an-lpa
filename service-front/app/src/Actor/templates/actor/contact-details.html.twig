{% extends '@actor/layout.html.twig' %}

{% block html_title %}{% trans %}request-activation-key.contact-details.title{% endtrans %} - {{ parent() }}{% endblock %}

{% block content %}
    <div class="govuk-width-container">
        <div role="navigation" aria-labelledby="back-link-navigation">
            <a href="{{ path(back) }}" class="govuk-back-link" id="back-link-navigation">{% trans %}common.back-link{% endtrans %}</a>
        </div>

        <main class="govuk-main-wrapper" id="main-content" role="main">

            {{ govuk_error_summary(form) }}

            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">

                    <h1 class="govuk-heading-xl govuk-!-margin-bottom-2">{% trans %}request-activation-key.contact-details.heading-page{% endtrans %}</h1>
                    <div id="lpa-type-hint" class="govuk-hint govuk-!-margin-bottom-6">{% trans %}request-activation-key.contact-details.hint-page{% endtrans %}</div>

                    {{ govuk_form_open(form) }}

                        {{ govuk_form_element(form.get('__csrf')) }}

                        {{ govuk_form_element(form.get('telephone_option').get('telephone'), {
                            'label': 'request-activation-key.contact-details.field-telephone.label'| trans,
                            'attr' : {'class': 'govuk-input--width-20', 'label_class': 'govuk-label'},
                            'inputmode': 'numeric',
                            'pattern': '[0-9 -]*'
                        }) }}

                        <p class="govuk-body govuk-!-margin-bottom-6">{% trans %}request-activation-key.contact-details.separator-or{% notes %}Shown between the phone number field and the “I do not have a phone” checkbox.{% endtrans %}</p>

                        {{ govuk_form_element(form.get('telephone_option').get('no_phone'), {
                            'label': 'request-activation-key.contact-details.field-no-phone.label'| trans,
                        }) }}

                    {% trans with {'%email%': user.getDetail('email')|e} %}
                        request-activation-key.contact-details.content-email
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes. The %email% placeholder is replaced with the user’s account email address. Preserve the HTML structure, classes and placeholder when translating.{% endtrans %}

                    <button data-prevent-double-click="true" type="submit" class="govuk-button govuk-!-margin-right-1">{% trans %}common.button-continue{% endtrans %}</button>

                    {{ govuk_form_close() }}
                </div>
            </div>
        </main>
    </div>
{% endblock %}
