{% extends '@actor/layout.html.twig' %}

{% block html_title %}{% trans %}request-activation-key.actor-address.title{% endtrans %} - {{ parent() }}{% endblock %}

{% block content %}
    <div class="govuk-width-container">
        <div role="navigation" aria-labelledby="back-link-navigation">
            <a href="{{ path(back) }}" class="govuk-back-link"
               id="back-link-navigation">{% trans %}common.back-link{% endtrans %}</a>
        </div>

        <main class="govuk-main-wrapper" id="main-content" role="main">

            {{ govuk_error_summary(form) }}

            <div class="govuk-grid-row">
                {{ govuk_form_open(form) }}
                <div class="govuk-grid-column-three-quarters">
                    <h1 class="govuk-heading-xl">{% trans %}request-activation-key.actor-address.heading-page{% endtrans %}</h1>
                    {% trans %}
                        request-activation-key.actor-address.content-intro
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes, and an abbreviation element for LPA. Preserve the HTML structure, classes and title attribute when translating.{% endtrans %}

                    {{ govuk_form_element(form.get('__csrf')) }}

                    {% if live_in_uk == 'No' %}
                        {{ govuk_form_element(form.get('actor_abroad_address'), {
                            'label': 'request-activation-key.actor-address.field-actor-abroad-address.label' | trans,
                            'autocomplete': 'street-address',
                        }) }}
                    {% else %}
                        {% trans with {'%postcode%': postcode|e} %}
                            request-activation-key.actor-address.content-postcode-given
                        {% context %}html{% notes %}Contains GOV.UK HTML elements and classes. The %postcode% placeholder is replaced with the postcode the user entered on the previous page. Preserve the HTML structure, classes and placeholder when translating.{% endtrans %}

                        {{ govuk_form_element(form.get('actor_address_1'), {
                            'label': 'request-activation-key.actor-address.field-actor-address-1.label' | trans,
                            'autocomplete': 'address-line1',
                        }) }}

                        {{ govuk_form_element(form.get('actor_address_2'), {
                            'label': 'request-activation-key.actor-address.field-actor-address-2.label' | trans,
                            'autocomplete': 'address-line2',
                        }) }}

                        {{ govuk_form_element(form.get('actor_address_town'), {
                            'label': 'request-activation-key.actor-address.field-actor-address-3.label' | trans,
                            'attr': { 'class': 'govuk-input govuk-!-width-two-thirds', 'autocomplete': 'address-level1'}
                        }) }}

                        {{ govuk_form_element(form.get('actor_address_county'), {
                            'label': 'request-activation-key.actor-address.field-actor-address-4.label' | trans,
                            'attr': { 'class': 'govuk-input govuk-!-width-two-thirds', 'autocomplete': 'address-level2'}
                        }) }}

                    {% endif %}

                    {% set label_same %}{% trans %}request-activation-key.actor-address.field-actor-address-check.label-yes{% context %}html{% notes %}Contains an HTML abbreviation element for LPA. Preserve the element and its title attribute when translating.{% endtrans %}{% endset %}
                    {% set label_different %}{% trans %}request-activation-key.actor-address.field-actor-address-check.label-no{% context %}html{% notes %}Contains an HTML abbreviation element for LPA. Preserve the element and its title attribute when translating.{% endtrans %}{% endset %}
                    {% set label_not_sure %}{% trans %}request-activation-key.actor-address.field-actor-address-check.label-not-sure{% context %}html{% notes %}Contains an HTML abbreviation element for LPA. Preserve the element and its title attribute when translating.{% endtrans %}{% endset %}

                    <div class="govuk-form-group">
                        <fieldset class="govuk-fieldset">

                            <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
                                <h2 class="govuk-fieldset__heading">
                                    {% trans %}request-activation-key.actor-address.field-actor-address-check.legend{% context %}html{% notes %}Contains an HTML abbreviation element for LPA. Preserve the element and its title attribute when translating.{% endtrans %}
                                </h2>
                            </legend>

                            {{ govuk_form_element(form.get('actor_address_check_radio'), {'value_options':
                                [
                                    {
                                        'label': label_same,
                                        'value': enum('Actor\\Workflow\\ActorAddressResponse').YES.value
                                    },
                                    {
                                        'label': label_different,
                                        'value': enum('Actor\\Workflow\\ActorAddressResponse').NO.value
                                    },
                                    {
                                        'label': label_not_sure,
                                        'value': enum('Actor\\Workflow\\ActorAddressResponse').NOT_SURE.value
                                    }
                                ]}
                            ) }}

                        </fieldset>
                    </div>

                    <button data-prevent-double-click="true" type="submit"
                            class="govuk-button">{% trans %}common.button-continue{% endtrans %}</button>

                    {{ govuk_form_close() }}

                </div>
            </div>
        </main>
    </div>
{% endblock %}
