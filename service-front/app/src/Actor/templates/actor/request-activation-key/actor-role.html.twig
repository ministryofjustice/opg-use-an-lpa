{% extends '@actor/layout.html.twig' %}

{% block html_title %}{% trans %}request-activation-key.actor-role.title{% endtrans %} - {{ parent() }}{% endblock %}

{% block content %}
    <div class="govuk-width-container">

        <div role="navigation" aria-labelledby="back-link-navigation">
            <a href="{{ path(back) }}" class="govuk-back-link"
               id="back-link-navigation">{% trans %}common.back-link{% endtrans %}</a>
        </div>

        <main class="govuk-main-wrapper" id="main-content" role="main">

            {{ govuk_error_summary(form) }}

            <div class="govuk-grid-row">
                {{ govuk_form_open(form) }}
                <div class="govuk-grid-column-two-thirds">

                    {{ govuk_form_element(form.get('__csrf')) }}

                    {% set hint_donor %}{% trans %}request-activation-key.actor-role.field-actor-role.hint-donor{% context %}html{% notes %}Contains an HTML abbreviation element for LPA. Preserve the element and its title attribute when translating.{% endtrans %}{% endset %}

                    <div class="govuk-form-group">
                        <fieldset class="govuk-fieldset">
                            <legend class="govuk-fieldset__legend govuk-fieldset__legend--xl">
                                <h1 class="govuk-fieldset__heading">
                                    {% trans %}request-activation-key.actor-role.heading-page{% context %}html{% notes %}Contains an HTML abbreviation element for LPA. Preserve the element and its title attribute when translating.{% endtrans %}
                                </h1>
                            </legend>

                            {{ govuk_form_element(form.get('actor_role_radio'), {'value_options':
                                [
                                    {
                                        'label': 'request-activation-key.actor-role.field-actor-role.label-donor'|trans,
                                        'hint': hint_donor,
                                        'value': 'Donor'
                                    },
                                    {
                                        'label': 'request-activation-key.actor-role.field-actor-role.label-attorney'|trans,
                                        'hint': 'request-activation-key.actor-role.field-actor-role.hint-attorney'|trans,
                                        'value': 'Attorney'
                                    },
                                    {
                                        'label': 'request-activation-key.actor-role.field-actor-role.label-replacement-attorney'|trans,
                                        'hint': 'request-activation-key.actor-role.field-actor-role.hint-replacement-attorney'|trans,
                                        'value': 'ReplacementAttorney'
                                    }
                                ]}
                            ) }}
                        </fieldset>
                    </div>

                    <button data-prevent-double-click="true" type="submit"
                            class="govuk-button">{% trans %}common.button-continue{% endtrans %}</button>

                    {{ govuk_form_close() }}
                </div>
            </div>
        </main>
    </div>
{% endblock %}
