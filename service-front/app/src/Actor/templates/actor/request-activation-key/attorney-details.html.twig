{% extends '@actor/layout.html.twig' %}

{% block html_title %}{% trans %}request-activation-key.attorney-details.title{% endtrans %} - {{ parent() }}{% endblock %}

{% block content %}
    <div class="govuk-width-container">
        <div role="navigation" aria-labelledby="back-link-navigation">
            <a href="{{ path(back) }}" class="govuk-back-link" id="back-link-navigation">{% trans %}common.back-link{% endtrans %}</a>
        </div>

        <main class="govuk-main-wrapper" id="main-content" role="main">

            {{ govuk_error_summary(form) }}

            <div class="govuk-grid-row">
                <div class="govuk-grid-column-one-half">

                    <h1 class="govuk-heading-xl">{% trans %}request-activation-key.attorney-details.heading-page{% endtrans %}</h1>
                    {% trans %}
                        request-activation-key.attorney-details.content-intro
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes, and an abbreviation element for LPA. Preserve the HTML structure, classes and title attribute when translating.{% endtrans %}

                    {{ govuk_form_open(form) }}

                    {{ govuk_form_element(form.get('__csrf')) }}

                    <h2 class="govuk-heading-l">{% trans %}request-activation-key.attorney-details.heading-attorney-name{% endtrans %}</h2>
                    {{ govuk_form_element(form.get('attorney_first_names'), {
                        'label': 'common.field-first-names.label' | trans,
                        'autocomplete': 'given-name',
                    }) }}

                    {{ govuk_form_element(form.get('attorney_last_name'), {
                        'label': 'common.field-last-name.label' | trans,
                        'autocomplete': 'family-name',
                    }) }}

                    {{ govuk_form_fieldset(form.get('attorney_dob'), {
                        'label': 'request-activation-key.attorney-details.field-attorney-dob.label'| trans,
                        'hint': 'request-activation-key.attorney-details.field-attorney-dob.hint'| trans,
                        'attr': {'class': 'xyz', 'label_class': 'govuk-label--m'}
                    }) }}

                    <button data-prevent-double-click="true" type="submit" class="govuk-button">{% trans %}common.button-continue{% endtrans %}</button>

                    {{ govuk_form_close() }}

                </div>
            </div>
        </main>
    </div>
{% endblock %}
