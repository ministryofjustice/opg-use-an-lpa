{% extends '@actor/layout.html.twig' %}

{% block html_title %}{% trans %}activation-key-request.start.title{% endtrans %} - {{ parent() }}{% endblock %}

{% block content %}
    <div class="govuk-width-container">
        <div role="navigation" aria-labelledby="back-link-navigation">
            <a href="{{ path('lpa.add') }}" class="govuk-back-link"
               id="back-link-navigation">{% trans %}activation-key-request.start.link.back{% endtrans %}</a>
        </div>

        <main class="govuk-main-wrapper" id="main-content" role="main">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">

                    <h1 class="govuk-heading-xl">{% trans %}activation-key-request.start.heading.page.title{% endtrans %}</h1>

                    <p class="govuk-body">{% trans %}activation-key-request.start.content.can-only-ask-for{% endtrans %}</p>

                    <ul class="govuk-list govuk-list--bullet">
                        <li>{% trans %}activation-key-request.start.condition.donor-or-attorney{% endtrans %}</li>
                        <li>{% trans %}activation-key-request.start.condition.england-and-wales{% endtrans %}</li>
                    </ul>

                    <p class="govuk-body">{% trans %}activation-key-request.start.content.cannot-ask-for{% endtrans %}</p>

                    <ul class="govuk-list govuk-list--bullet">
                        <li>{% trans %}activation-key-request.start.restriction.pre-2016{% endtrans %}</li>
                        <li>{% trans %}activation-key-request.start.restriction.epa{% endtrans %}</li>
                        <li>{% trans %}activation-key-request.start.restriction.scotland{% endtrans %}</li>
                    </ul>

                    <h2 class="govuk-heading-m">{% trans %}activation-key-request.start.heading.details.title{% endtrans %}</h2>

                    <ul class="govuk-list govuk-list--bullet">
                        <li>{% trans %}activation-key-request.start.details.name-and-date-of-birth{{% endtrans %}</li>
                        <li>{% trans with {'%link%': path('contact-us')} %}activation-key-request.start.details.current-address{% endtrans %}</li>
                        <li>{% trans %}activation-key-request.start.details.reference-number{% endtrans %}</li>
                    </ul>


                    <details class="govuk-details govuk-!-margin-bottom-7" data-module="govuk-details"
                             data-gaEventType="onClick" data-gaAction="Details"
                             data-gaCategory="Unkown Reference Number"
                             data-gaLabel="I do not know the LPA reference number">
                        <summary class="govuk-details__summary">
                            <span class="govuk-details__summary-text">
                                {% trans %}activation-key-request.reveal.start.heading.title{% endtrans %}
                            </span>
                        </summary>
                        <div class="govuk-details__text">
                            <p>{% trans %}activation-key-request.reveal.start.summary.content.block.first{% endtrans %}</p>
                            <p>{% trans %}ctivation-key-request.reveal.start.summary.content.block.second{% endtrans %}</p>
                            <p>{% trans with {'%link%': path('contact-us')} %}ctivation-key-request.reveal.start.summary.content.block.third{% endtrans %}</p>
                        </div>
                    </details>
                    <div class="moj-button-menu">
                        <a href="{{ path('lpa.add-by-paper', {}, {'startAgain': 'true'}) }}" role="button"
                           draggable="false" class="govuk-button moj-button-menu__item  "
                           data-module="govuk-button">
                            {% trans %}activation-key-request.start.continue.button{% endtrans %}
                        </a>
                        <a href="{{ path('lpa.dashboard') }}" role="button" draggable="false"
                           class="govuk-button moj-button-menu__item govuk-button--secondary "
                           data-module="govuk-button">
                            {% trans %}activation-key-request.start.cancel.button{% endtrans %}
                        </a>
                    </div>
                </div>
            </div>
        </main>
    </div>
{% endblock %}
