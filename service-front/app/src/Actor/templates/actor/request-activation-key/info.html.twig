{% extends '@actor/layout.html.twig' %}

{% block html_title %}{% trans %}request-activation-key.info.title{% endtrans %} - {{ parent() }}{% endblock %}

{% block content %}
    <div class="govuk-width-container">
        <div role="navigation" aria-labelledby="back-link-navigation">
            <a href="{{ path('lpa.add') }}" class="govuk-back-link" id="back-link-navigation">{% trans %}common.back-link{% endtrans %}</a>
        </div>

        <main class="govuk-main-wrapper" id="main-content" role="main">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">

                    <h1 class="govuk-heading-xl">{% trans %}request-activation-key.info.heading-page{% endtrans %}</h1>

                    <h2 class="govuk-heading-m">{% trans %}request-activation-key.info.heading-can-only-ask{% endtrans %}</h2>
                    {% trans %}
                        request-activation-key.info.content-can-only-ask
                    {% context %}html{% notes %}Contains a GOV.UK bulleted list and abbreviation elements for LPA. Preserve the HTML structure, classes and title attributes when translating.{% endtrans %}

                    <details class="govuk-details govuk-!-margin-bottom-2" data-module="govuk-details" data-gaEventType="onClick" data-gaAction="Registration Date" data-gaCategory="Details" data-gaLabel="Where to find the LPA registration date">
                        <summary class="govuk-details__summary">
                            <span class="govuk-details__summary-text">
                                {% trans %}request-activation-key.info.reveal-registration-date-title{% context %}html{% notes %}Contains an HTML abbreviation element for LPA. Preserve the element and its title attribute when translating.{% endtrans %}
                            </span>
                        </summary>
                        <div class="govuk-details__text">
                            {% trans %}
                                request-activation-key.info.reveal-registration-date-content
                            {% context %}html{% notes %}Contains HTML paragraphs and abbreviation elements for LPA. Preserve the HTML structure and title attributes when translating.{% endtrans %}
                        </div>
                    </details>

                    <details class="govuk-details" data-module="govuk-details" data-gaEventType="onClick" data-gaAction="Details" data-gaCategory="Registered Before" data-gaLabel="LPAs registered before 1 September 2019">
                        <summary class="govuk-details__summary">
                            <span class="govuk-details__summary-text">
                                {% trans %}request-activation-key.info.reveal-registered-before-title{% context %}html{% notes %}Contains an HTML abbreviation element for LPAs. Preserve the element and its title attribute when translating.{% endtrans %}
                            </span>
                        </summary>
                        <div class="govuk-details__text">
                            {% trans %}
                                request-activation-key.info.reveal-registered-before-content
                            {% context %}html{% notes %}Contains an HTML abbreviation element for LPA. Preserve the element and its title attribute when translating.{% endtrans %}
                        </div>
                    </details>

                    <h2 class="govuk-heading-m">{% trans %}request-activation-key.info.heading-details-changed{% endtrans %}</h2>
                    {% trans with {'%link%': path('lpa.change-details')} %}
                        request-activation-key.info.content-details-changed
                    {% context %}html-link{% notes %}Contains GOV.UK paragraphs, a bulleted list and abbreviation elements for LPA, and a link to the change details page using the %link% placeholder. Preserve the HTML structure, classes, title attributes and placeholder when translating.{% endtrans %}

                    <a href="{{ path('lpa.add-by-paper', {}, {'startAgain': 'true'}) }}" class="govuk-button">{% trans %}common.button-continue{% endtrans %}</a>

                    <a href="{{ path('lpa.dashboard') }}" draggable="false" class="govuk-button govuk-button--secondary">{% trans %}common.button-cancel{% endtrans %}</a>

                </div>
            </div>
        </main>
    </div>
{% endblock %}
