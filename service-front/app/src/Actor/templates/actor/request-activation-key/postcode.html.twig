{% extends '@actor/layout.html.twig' %}

{% block html_title %}{% trans %}request-activation-key.postcode.title{% endtrans %} - {{ parent() }}{% endblock %}

{% block content %}
    <div class="govuk-width-container">

        <div role="navigation" aria-labelledby="back-link-navigation">
            <a href="{{ path(back) }}" class="govuk-back-link" id="back-link-navigation">{% trans %}common.back-link{% endtrans %}</a>
        </div>

        <main class="govuk-main-wrapper" id="main-content" role="main">

            {{ govuk_error_summary(form) }}

            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">

                    <h1 class="govuk-heading-xl" id="postcode_heading">{% trans %}request-activation-key.postcode.heading-page{% endtrans %}</h1>
                    {% trans %}
                        request-activation-key.postcode.content-intro
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes. Preserve the HTML structure and classes when translating.{% endtrans %}

                    {{ govuk_form_open(form) }}

                    {{ govuk_form_element(form.get('__csrf')) }}

                    {{ govuk_form_element(form.get('live_in_uk'), {'value_options':
                        [
                            {
                                'label': 'request-activation-key.postcode.field-live-in-uk.label-yes'| trans,
                                'value': 'Yes',
                                'conditionalContent': {"postcode": govuk_form_element(form.get('postcode'),{'label': 'request-activation-key.postcode.field-postcode.label'| trans})}
                            },
                            {
                                'label': 'request-activation-key.postcode.field-live-in-uk.label-no'| trans,
                                'value': 'No'
                            },
                        ]}
                    ) }}

                    <div class="moj-button-menu">
                        <button data-prevent-double-click="true" type="submit"
                                class="govuk-button moj-button-menu__item">{% trans %}common.button-continue{% endtrans %}</button>

                        <a href="{{ path('lpa.dashboard') }}" role="button" draggable="false"
                           class="govuk-button moj-button-menu__item govuk-button--secondary "
                           data-module="govuk-button">
                            {% trans %}common.button-cancel{% endtrans %}
                        </a>
                    </div>

                    {{ govuk_form_close() }}
                </div>
            </div>
        </main>
    </div>
{% endblock %}
