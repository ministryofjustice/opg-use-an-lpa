{% extends '@actor/layout.html.twig' %}

{% block html_title %}{% trans %}request-activation-key.reference-number.title{% endtrans %} - {{ parent() }}{% endblock %}

{% block content %}
    <div class="govuk-width-container">
        <div role="navigation" aria-labelledby="back-link-navigation">
            <a href="{{ path(back) }}" class="govuk-back-link" id="back-link-navigation">{% trans %}common.back-link{% endtrans %}</a>
        </div>

        <main class="govuk-main-wrapper" id="main-content" role="main">

            {{ govuk_error_summary(form) }}

            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">

                    {{ govuk_form_open(form) }}

                        {{ govuk_form_element(form.get('__csrf')) }}

                        {{ govuk_form_element(form.get('opg_reference_number'), {
                            'label': 'request-activation-key.reference-number.opg_reference_number' | trans,
                            'label_is_page_heading': true,
                            'hint': feature_enabled("paper_verification") ? 'request-activation-key.reference-number.field-lpa-reference-number.hint-with-paper-verification' | trans : 'request-activation-key.reference-number.field-lpa-reference-number.hint-without-paper-verification' | trans,
                            'attr' : {
                                'class': 'govuk-input--width-20 govuk-input--extra-letter-spacing',
                                'label_class': 'govuk-label--xl'
                            },
                            'spellcheck': 'false'
                        }) }}

                        <button data-prevent-double-click="true" type="submit" class="govuk-button govuk-!-margin-right-1">{% trans %}common.button-continue{% endtrans %}</button>

                        <a href="{{ path('lpa.dashboard') }}" role="button" draggable="false"
                           class="govuk-button moj-button-menu__item govuk-button--secondary "
                           data-module="govuk-button">
                            {% trans %}common.button-cancel{% endtrans %}
                        </a>
                    {{ govuk_form_close() }}
                </div>
            </div>
        </main>
    </div>
{% endblock %}
