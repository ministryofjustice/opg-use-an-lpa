{% extends '@actor/layout.html.twig' %}

{% block html_title %}{% trans %}request-activation-key.replacement-attorney.title{% endtrans %} - {{ parent() }}{% endblock %}

{% block content %}
    <div class="govuk-width-container">
        <div role="navigation" aria-labelledby="back-link-navigation">
            <a href="{{ path('lpa.dashboard') }}" class="govuk-back-link"
               id="back-link-navigation">{% trans %}common.back-link{% endtrans %}</a>
        </div>

        <main class="govuk-main-wrapper" id="main-content" role="main">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">

                    <h1 class="govuk-heading-xl">
                        {% trans %}request-activation-key.replacement-attorney.heading-page{% endtrans %}
                    </h1>

                    {% trans %}
                        request-activation-key.replacement-attorney.content-becoming-active
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes, and links to GOV.UK guidance. Preserve the HTML structure, classes and link destinations when translating.{% endtrans %}

                    <a href="{{ path('lpa.dashboard') }}" draggable="false" class="govuk-button">
                        {% trans %}common.button-back-to-your-lpas{% endtrans %}
                    </a>
                </div>
            </div>
        </main>
    </div>
{% endblock %}
