{% extends '@viewer/layout.html.twig' %}

{% block page_title %}{% trans %}view-lpa.enter-code.title{% endtrans %}{% endblock %}

{% block content %}
<div class="govuk-width-container">
    <main class="govuk-main-wrapper" id="main-content" role="main">

        {{ include('@viewer/partials/service-message.html.twig') }}

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">

                {{ govuk_error_summary(form) }}

                {{ govuk_form_open(form) }}

                    <fieldset class="govuk-fieldset">

                        <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
                            <h1 class="govuk-heading-xl">
                                {% trans %}
                                    view-lpa.enter-code.heading-page
                                {% context %}html{% notes %}Contains an abbr element for LPA. Preserve the HTML when translating.{% endtrans %}
                            </h1>
                        </legend>

                        {% trans %}
                            view-lpa.enter-code.content-intro
                        {% context %}html{% notes %}Contains a GOV.UK paragraph element and class and an abbr element for LPA. Preserve the HTML structure and classes when translating.{% endtrans %}

                        {{ govuk_form_element(form.get('__csrf')) }}

                        {{ govuk_form_element(form.get('donor_surname'),
                            {
                                'label': 'view-lpa.enter-code.field-donor-surname.label' | trans,
                                'attr' : {'class': 'govuk-input--width-10'}

                            }
                        ) }}

                        {% set lpaCodeHint %}
                            {% trans %}
                                view-lpa.enter-code.field-lpa-code.hint
                            {% context %}html{% notes %}Contains an HTML line break. Preserve the line break and markup when translating.{% endtrans %}
                        {% endset %}

                        {{ govuk_form_element(form.get('lpa_code'),
                            {
                                'label': 'view-lpa.enter-code.field-lpa-code.label' | trans,
                                'input_prefix': 'V-',
                                'hint': lpaCodeHint,
                                'attr' : {'class': 'govuk-input--width-10'}
                            }
                        ) }}

                        <details id="access-code-reveal" class="govuk-details" data-module="govuk-details" data-gaEventType="onClick" data-gaAction="AccessCodeReveal" data-gaCategory="Details" data-gaLabel="The code I\'ve been given does not begin with a V">
                            <summary class="govuk-details__summary" role="button" >
                                <span class="govuk-details__summary-text">
                                    {% trans %}view-lpa.enter-code.reveal-wrong-code-title{% endtrans %}
                                </span>
                            </summary>
                            <div class="govuk-details__text">
                                {% trans %}
                                    view-lpa.enter-code.reveal-wrong-code-content
                                {% context %}html{% notes %}Contains paragraph elements, abbr elements for LPA and a link to the Use a lasting power of attorney service on GOV.UK. Preserve the HTML structure and link destination when translating.{% endtrans %}
                            </div>
                        </details>

                        {% trans %}
                            view-lpa.enter-code.content-epa
                        {% context %}html{% notes %}Contains a GOV.UK paragraph element and class. Preserve the HTML structure and classes when translating.{% endtrans %}

                        {% trans with {'%link%': path('terms-of-use')} %}
                            view-lpa.enter-code.content-terms
                        {% context %}html-link{% notes %}Contains a GOV.UK paragraph element and a terms of use link, opening in a new tab, using the %link% placeholder. Preserve the HTML, link attributes and placeholder when translating.{% endtrans %}

                        <button data-prevent-double-click="true" type="submit" class="govuk-button">{% trans %}common.button-continue{% endtrans %}</button>

                    </fieldset>

                {{ govuk_form_close() }}
            </div>
        </div>
    </main>
</div>
{% endblock %}
