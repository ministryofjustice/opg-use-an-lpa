{% extends '@viewer/layout.html.twig' %}

{% block page_title %}{% trans %}view-lpa.enter-code-paper-verification.title{% endtrans %}{% endblock %}

{% block content %}
    <div class="govuk-width-container">
        <main class="govuk-main-wrapper" id="main-content" role="main">
            {{ include('@viewer/partials/service-message.html.twig') }}
            {{ govuk_error_summary(form) }}

            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">
                    {{ govuk_form_open(form) }}
                    {{ govuk_form_element(form.get('__csrf')) }}

                    <fieldset class="govuk-fieldset">
                        <legend class="govuk-fieldset__legend govuk-fieldset__legend--xl">
                            <h1 class="govuk-fieldset__heading">
                                {% trans %}
                                    view-lpa.enter-code-paper-verification.heading-page
                                {% context %}html{% notes %}Contains an abbr element for LPA. Preserve the HTML when translating.{% endtrans %}
                            </h1>
                        </legend>

                        <details id="what-are-access-codes-reveal" class="govuk-details" data-gaEventType="onClick" data-gaAction="AccessCodeReveal" data-gaCategory="Details" data-gaLabel="What are LPA access and paper verification codes?">
                            <summary class="govuk-details__summary">
                                <span class="govuk-details__summary-text">
                                    {% trans %}
                                        view-lpa.enter-code-paper-verification.reveal-code-types-title
                                    {% context %}html{% notes %}Contains an abbr element for LPA. Preserve the HTML when translating.{% endtrans %}
                                </span>
                            </summary>
                            <div class="govuk-details__text">
                                {% trans %}
                                    view-lpa.enter-code-paper-verification.reveal-code-types-content
                                {% context %}html{% notes %}Contains GOV.UK paragraph, heading and list elements and classes, and abbr elements for LPA. Preserve the HTML structure and classes when translating.{% endtrans %}
                            </div>
                        </details>

                        {{ govuk_form_element(form.get('donor_surname'), {
                              'label': 'view-lpa.enter-code-paper-verification.field-donor-surname.label' | trans
                        }) }}

                        {% set lpaCodeHint %}
                            {% trans %}
                                view-lpa.enter-code-paper-verification.field-lpa-code.hint
                            {% context %}html{% notes %}Contains an HTML line break. Preserve the line break and markup when translating.{% endtrans %}
                        {% endset %}

                        {{ govuk_form_element(form.get('lpa_code'), {
                               'label': 'view-lpa.enter-code-paper-verification.field-lpa-code.label' | trans,
                               'hint': lpaCodeHint
                        }) }}

                        <details id="access-code-reveal" class="govuk-details" data-module="govuk-details" data-gaEventType="onClick" data-gaAction="AccessCodeReveal" data-gaCategory="Details" data-gaLabel="The code I\'ve been given does not start with V or P.">
                            <summary class="govuk-details__summary" role="button" >
                                <span class="govuk-details__summary-text">
                                    {% trans %}view-lpa.enter-code-paper-verification.reveal-wrong-code-title{% endtrans %}
                                </span>
                            </summary>
                            <div class="govuk-details__text">
                                {% trans %}
                                    view-lpa.enter-code-paper-verification.reveal-wrong-code-content
                                {% context %}html{% notes %}Contains a GOV.UK paragraph element and class. Preserve the HTML structure and classes when translating.{% endtrans %}
                            </div>
                        </details>

                        {% trans with {'%link%': path('terms-of-use')} %}
                            view-lpa.enter-code-paper-verification.content-terms
                        {% context %}html-link{% notes %}Contains a GOV.UK paragraph element and a terms of use link, opening in a new tab, using the %link% placeholder. Preserve the HTML, link attributes and placeholder when translating.{% endtrans %}

                        <button data-prevent-double-click="true" type="submit" class="govuk-button">{% trans %}common.button-continue{% endtrans %}</button>

                    </fieldset>

                    {{ govuk_form_close() }}
                </div>
            </div>
        </main>
    </div>
{% endblock %}
