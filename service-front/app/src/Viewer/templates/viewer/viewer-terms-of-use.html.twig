{% extends '@viewer/layout.html.twig' %}

{% block page_title %}{% trans %}terms-of-use.view.title{% endtrans %}{% endblock %}

{% block content %}
    <div class="govuk-width-container">
        <main class="govuk-main-wrapper" id="main-content" role="main">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">

                    <h1 class="govuk-heading-xl" data-content-id="terms-of-use">
                        {% trans %}terms-of-use.view.heading-page{% endtrans %}
                    </h1>

                    {% trans %}
                        terms-of-use.view.content-intro
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes. Preserve the HTML structure and classes when translating.{% endtrans %}

                    {% trans %}
                        terms-of-use.view.content-agreement
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes, and links to external websites. Preserve the HTML structure, classes and link destinations when translating.{% endtrans %}

                    <div class="govuk-warning-text">
                        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
                        <strong class="govuk-warning-text__text">
                            <span class="govuk-visually-hidden">{% trans %}common.warning-hidden-text{% notes %}Visually hidden prefix read out by screen readers before GOV.UK warning text, shown alongside a “!” icon. It is not visible on screen.{% endtrans %}</span>
                            {% trans %}
                                terms-of-use.view.warning-personal-information
                            {% endtrans %}
                        </strong>
                    </div>

                    <h2 class="govuk-heading-m">{% trans %}terms-of-use.view.heading-information-security{% endtrans %}</h2>
                    {% trans %}
                        terms-of-use.view.content-information-security
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes. Preserve the HTML structure and classes when translating.{% endtrans %}

                    <h3 class="govuk-heading-s">{% trans %}terms-of-use.view.heading-access-securely{% endtrans %}</h3>
                    {% trans %}
                        terms-of-use.view.content-access-securely
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes. Preserve the HTML structure and classes when translating.{% endtrans %}

                    <h2 class="govuk-heading-m">{% trans %}terms-of-use.view.heading-keeping-up-to-date{% endtrans %}</h2>
                    {% trans %}
                        terms-of-use.view.content-keeping-up-to-date
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes. Preserve the HTML structure and classes when translating.{% endtrans %}

                    <h2 class="govuk-heading-m">{% trans %}terms-of-use.view.heading-tracking{% endtrans %}</h2>
                    {% trans with {'%privacy-link%': path('privacy-notice'), '%cookies-link%': path('cookies')} %}
                        terms-of-use.view.content-tracking
                    {% context %}html-link{% notes %}Contains GOV.UK HTML markup, a privacy notice link using the %privacy-link% placeholder and a cookie policy link using the %cookies-link% placeholder. Preserve the HTML and placeholders when translating.{% endtrans %}

                    <h2 class="govuk-heading-m">{% trans %}terms-of-use.view.heading-fraud{% endtrans %}</h2>
                    {% trans %}
                        terms-of-use.view.content-fraud
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes, and links to external websites. Preserve the HTML structure, classes and link destinations when translating.{% endtrans %}

                    <h2 class="govuk-heading-m">{% trans %}terms-of-use.view.heading-governing-law{% endtrans %}</h2>
                    {% trans %}
                        terms-of-use.view.content-governing-law
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes. Preserve the HTML structure and classes when translating.{% endtrans %}

                    <h2 class="govuk-heading-m">{% trans %}terms-of-use.view.heading-about{% endtrans %}</h2>
                    {% trans %}
                        terms-of-use.view.content-about
                    {% context %}html{% notes %}Contains GOV.UK HTML elements and classes. Preserve the HTML structure and classes when translating.{% endtrans %}
                </div>
            </div>
        </main>
    </div>
{% endblock %}
