{
  "name": "web",
  "version": "1.0.0",
  "type": "module",
  "description": "Web components for the use lpa service",
  "main": "index.js",
  "repository": "git@github.com:ministryofjustice/opg-use-an-lpa.git",
  "scripts": {
    "test": "CI=true jest --coverage",
    "jest": "jest",
    "test:watch": "jest --watch",
    "install-and-build": "npm ci --ignore-scripts && npm run build",
    "build": " npm run build-scss && BABEL_ENV=build babel src --out-dir dist && node build.js",
    "accessibility-check": "node ./pa11y.js",
    "build-scss": "npm rebuild sass --verbose && sass --load-path=./ --verbose src/main.scss:dist/stylesheets/main.css src/gds.scss:dist/stylesheets/gds.css src/pdf.scss:dist/pdf.css --style compressed"
  },
  "author": "John Nolan <john.nolan@digital.justice.gov.uk>",
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^8.0.0",
    "@babel/core": "^8.0.0",
    "@babel/plugin-transform-member-expression-literals": "^8.0.0",
    "@babel/plugin-transform-property-literals": "^8.0.0",
    "@babel/plugin-transform-reserved-words": "^8.0.0",
    "@babel/plugin-transform-runtime": "^8.0.0",
    "@babel/preset-env": "^8.0.0",
    "@babel/runtime-corejs3": "^8.0.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "babel-jest": "^30.0.0",
    "core-js": "^3.26.0",
    "es6-promise": "^4.2.8",
    "esbuild": "0.28.2",
    "esbuild-sass-plugin": "^3.2.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-junit": "^17.0.0",
    "prettier": "^3.0.0",
    "sass": "^1.75.0"
  },
  "dependencies": {
    "@babel/runtime": "8.0.0",
    "@govuk-one-login/service-header": "^6.0.0",
    "@jest/globals": "^30.0.0",
    "@ministryofjustice/frontend": "^9.0.0",
    "govuk-frontend": "^6.0.0",
    "perfume.js": "^6.4.0"
  },
  "jest-junit": {
    "outputDirectory": "./test-results/junit",
    "outputName": "results.xml"
  }
}
